# nip46-relay configuration
#
# Copy this file to .env and edit. It is read on startup for local runs, by
# docker compose (env_file), and by systemd (EnvironmentFile).
#
# Convention: uncommented lines are active. Commented (#) lines are optional —
# leave them off to use the built-in default (or to leave the value unset).

# ─── Required ────────────────────────────────────────────────────────────────
# Public WebSocket URL clients use to reach this relay. Set this for your
# deployment; it is advertised in NIP-11 and shown on the landing page.
RELAY_URL="wss://your-domain.com"

# ─── Recommended ─────────────────────────────────────────────────────────────
# Administrative contact pubkey (hex). NIP-11 marks every field optional, but a
# Nostr pubkey is its preferred way for clients to reach the operator (abuse
# reports, bugs, support). Leave empty to omit it from NIP-11 entirely.
RELAY_PUBKEY=""

# ─── Relay identity (defaults shown) ─────────────────────────────────────────
RELAY_NAME="NIP-46 Relay"
RELAY_DESCRIPTION="A NIP-46 remote signing relay"

# ─── Server & performance (defaults shown) ───────────────────────────────────
# Address to listen on (host:port; host optional).
RELAY_PORT=":3334"

# Storage backend: "memory" (default, ephemeral, no disk) or "badger" (persists
# across restarts). The in-memory store keeps signing latency off the disk path.
STORAGE_BACKEND="memory"

# Byte budget for the in-memory store, in MB. 0 = auto: ~50% of the effective
# memory limit (your GOMEMLIMIT if set, else detected host/cgroup RAM).
# Ignored when STORAGE_BACKEND=badger.
MAX_MEMORY_MB=0

# How long events are retained before eviction, in minutes.
KEEP_IN_MINUTES=10

# Reject events whose timestamp is outside +/- this many minutes from now.
ACCEPT_WINDOW_IN_MINUTES=1

# Max events accepted per minute, per pubkey.
RATE_LIMIT_PER_MINUTE=100

# ─── Optional ────────────────────────────────────────────────────────────────
# Fallback contact (e.g. mailto: or https: URI). NIP-11 prefers RELAY_PUBKEY
# above; set this only as an alternative.
# RELAY_CONTACT=""

# URLs for the relay's icon and banner images.
# RELAY_ICON=""
# RELAY_BANNER=""

# Data directory for the badger backend. Only used when STORAGE_BACKEND=badger.
# WORKING_DIR="./nip46-relay-data"
